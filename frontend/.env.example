# Local development — copy to .env:
#   cp .env.example .env
# Production — see .env.production.example (set VITE_API_URL in Vercel).
# Must include the /api suffix. No trailing slash after /api.
#
# Local:  http://localhost:5000/api
# Prod:   https://mini-store-backend.onrender.com/api
#         (must match backend API_PUBLIC_URL + /api)

VITE_API_URL=http://localhost:5000/api
